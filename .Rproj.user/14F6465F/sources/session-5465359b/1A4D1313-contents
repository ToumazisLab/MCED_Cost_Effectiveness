## ---------- Helpers (unchanged/trimmed) -------------------------------------

get_stage_distribution <- function(matrix) {
  stage_counts <- colSums(matrix)
  stage_labels <- sub("_.*", "", names(stage_counts))
  total <- sum(stage_counts)
  tapply(stage_counts, stage_labels, sum) / total
}

get_stage_distribution_by_cancer <- function(matrix) {
  stage_counts <- colSums(matrix)
  tibble(
    Stage  = sub("_.*", "", names(stage_counts)),
    Cancer = sub(".*_", "", names(stage_counts)),
    Count  = stage_counts
  ) %>%
    group_by(Cancer, Stage) %>%
    summarise(Proportion = Count / sum(Count), .groups = "drop")
}

safe_sum <- function(x) if (is.null(x)) 0 else sum(x, na.rm = TRUE)

pull_icer <- function(icer_df, var) {
  v <- icer_df$Value[icer_df$Variable == var]
  if (length(v)) v[1] else 0
}

## ---------- Core extractor reused by both summaries --------------------------

.extract_metrics <- function(run_obj, arm = c("m", "uc")) {
  arm <- match.arg(arm)
  icer_df    <- run_obj[["final_result_list"]][["Overall"]][["final_icer_result"]]
  summary_df <- run_obj[["overall_summary"]]
  
  if (arm == "uc") {
    list(
      cost          = pull_icer(icer_df, "usual_cost"),
      qalys         = pull_icer(icer_df, "usual_utility"),
      inc_cost      = 0,
      inc_qalys     = 0,
      icer          = 0,
      stage_dist    = get_stage_distribution(run_obj[["incident_matrix_trimmed"]]),
      stage_by_cx   = get_stage_distribution_by_cancer(run_obj[["incident_matrix_trimmed"]]),
      deaths_avert  = 0,
      overdx        = 0,
      tp            = 0,
      fn            = 0,
      screen_dx     = safe_sum(summary_df %>% filter(Arm == "uc", Variable %in% "screen_dx") %>% pull(Value)),
      incidental_dx = safe_sum(summary_df %>% filter(Arm == "uc", Variable == "incidental_dx") %>% pull(Value)),
      imaging_cost  = safe_sum(summary_df %>% filter(Arm == "uc", Variable %in% c("h_Imaging_cost","c_Imaging_cost")) %>% pull(Value)),
      diagnostic_cost = safe_sum(summary_df %>% filter(Arm == "uc", Variable %in% c("h_Diagnostic_cost","c_Diagnostic_cost")) %>% pull(Value)),
      invasive_cost = safe_sum(summary_df %>% filter(Arm == "uc", Variable %in% c("h_Invasive_cost","c_Invasive_cost")) %>% pull(Value)),
      fp_count      = safe_sum(summary_df %>% filter(Arm == "uc", Variable == "UC_FPx1") %>% pull(Value)),
      fp_procedures = safe_sum(summary_df %>% filter(Arm == "uc", Variable %in% c("UC_FPx1","UC_FPx2")) %>% pull(Value)),
      true_TN       = 0,
      fp_percent    = 0
    )
  } else {
    downstream_procedures <- safe_sum(summary_df %>% filter(Arm == "m", Variable %in% c("FPx2","FPx3","UC_FPx1","UC_FPx2")) %>% pull(Value))
    fp_counts_list <- run_obj[["final_result_list"]][["Overall"]][["mced_TN_FP"]]
    
    fp_count   <- safe_sum(fp_counts_list[["fp_counts"]])
    total_fp_fu <- safe_sum(fp_counts_list[["Total_FP_fu"]]) + downstream_procedures
    true_TN    <- safe_sum(fp_counts_list[["True_TN"]])
    denom      <- fp_count + true_TN
    fp_percent <- if (denom > 0) 100 * fp_count / denom else 0
    
    list(
      cost          = pull_icer(icer_df, "mced_cost"),
      qalys         = pull_icer(icer_df, "mced_utility"),
      inc_cost      = pull_icer(icer_df, "Incremental_Cost"),
      inc_qalys     = pull_icer(icer_df, "Incremental_Utility"),
      icer          = pull_icer(icer_df, "ICER"),
      stage_dist    = get_stage_distribution(run_obj[["mced_incident_matrix"]]),
      stage_by_cx   = get_stage_distribution_by_cancer(run_obj[["mced_incident_matrix"]]),
      deaths_avert  = safe_sum(summary_df %>% filter(Arm == "m_v_uc", Variable == "Cancer_deaths_averted") %>% mutate(Value = pmax(Value, 0)) %>% pull(Value)),
      overdx        = safe_sum(summary_df %>% filter(Arm == "m", Variable == "overdx_Total") %>% pull(Value)),
      tp            = safe_sum(summary_df %>% filter(Arm == "m", Variable == "s_cases_TP") %>% pull(Value)),
      fn            = safe_sum(summary_df %>% filter(Arm == "m", Variable %in% c("s_cases_FN","i_cases_FN")) %>% pull(Value)),
      screen_dx     = safe_sum(summary_df %>% filter(Arm == "m", Variable %in% c("screen_dx","mced_dx")) %>% pull(Value)),
      incidental_dx = safe_sum(summary_df %>% filter(Arm == "m", Variable == "incidental_dx") %>% pull(Value)),
      imaging_cost  = safe_sum(summary_df %>% filter(Arm == "m", Variable %in% c("h_Imaging_cost","c_Imaging_cost")) %>% pull(Value)),
      diagnostic_cost = safe_sum(summary_df %>% filter(Arm == "m", Variable %in% c("h_Diagnostic_cost","c_Diagnostic_cost")) %>% pull(Value)),
      invasive_cost = safe_sum(summary_df %>% filter(Arm == "m", Variable %in% c("h_Invasive_cost","c_Invasive_cost")) %>% pull(Value)),
      fp_count      = fp_count,
      fp_procedures = total_fp_fu,
      true_TN       = true_TN,
      fp_percent    = fp_percent
    )
  }
}

## ---------- Summarizers (now thin wrappers around .extract_metrics) ----------

secondary_summarize_run <- function(run_obj, run_name, is_usual = FALSE) {
  arm <- if (is_usual) "uc" else "m"
  M <- .extract_metrics(run_obj, arm)
  
  tibble(
    Run = run_name,
    `True Positives`              = round(M$tp),
    `False Negatives`             = round(M$fn),
    `Screen-diagnosed cases`      = round(M$screen_dx),
    `Incidentally diagnosed cases`= round(M$incidental_dx),
    `Cancer Deaths Averted`       = round(M$deaths_avert, 0),
    `Cases Overdiagnosed`         = round(M$overdx, 0)
  )
}

main_summarize_run <- function(run_obj, run_name, is_usual = FALSE) {
  arm <- if (is_usual) "uc" else "m"
  M <- .extract_metrics(run_obj, arm)
  
  tibble(
    Run                          = run_name,
    `Cost (M, $USD)`             = round(M$cost/1e6, 0),
    `QALYs (Th)`                 = round(M$qalys/1e3, 0),
    `Incremental Cost (M, $USD)` = round(M$inc_cost/1e6, 0),
    `Incremental Utility`        = round(M$inc_qalys, 0),
    ICER                         = round(M$icer, 0),
    `Imaging cost (M, $USD)`     = round(M$imaging_cost/1e6),
    `Diagnostic cost (M, $USD)`  = round(M$diagnostic_cost/1e6),
    `Invasive cost (M, $USD)`    = round(M$invasive_cost/1e6),
    `FPs (MCD exams resulting in at least 1 MCD FP, Th)` = round(M$fp_count/1e3, 0),
    `Downstream FP Procedures (count)`                    = round(M$fp_procedures/1e3, 0),
    `TN (Count, Th)`             = round(M$true_TN/1e3, 0),
    `FP (%)`                     = round(M$fp_percent, 0)
  )
}

