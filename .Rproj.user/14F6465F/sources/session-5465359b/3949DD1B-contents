spec_thresholds <- c(0.95, 0.96, 0.97, 0.98, 0.99, 0.995)

psa_ce_thresholds <- map_df(spec_thresholds, function(thresh) {
  filtered <- psa_design_final %>%
    filter(all_spec > thresh) %>%
    select(run_id)
  
  joined <- psa_out_final %>%
    semi_join(filtered, by = "run_id") %>%
    mutate(
      NMB = Incremental_Utility * wtp - Incremental_Cost,
      CE = NMB > 0
    )
  
  tibble(
    spec_thresh = thresh,
    label = paste0("MCD Test Specificity > ", formatC(thresh, format = "f", digits = 3)),
    pct_CE = mean(joined$CE) * 100
  )
})

psa_cloud <- psa_out_final %>%
  left_join(select(psa_design_final, run_id, all_spec), by = "run_id") %>%
  mutate(spec_thresh = cut(
    all_spec,
    breaks = c(spec_thresholds, Inf),
    labels = spec_thresholds,
    right = FALSE
  )) %>%
  mutate(spec_thresh = as.numeric(as.character(spec_thresh))) %>%
  left_join(psa_ce_thresholds, by = "spec_thresh") %>%
  mutate(label_ce = paste0(label, " (", round(pct_CE, 1), "% CE)"))

bucket_colors <- c(
  "MCD Test Specificity > 0.950"  = "#D9D9D9",
  "MCD Test Specificity > 0.960"  = "#BFBFBF",
  "MCD Test Specificity > 0.970"  = "#A6A6A6",
  "MCD Test Specificity > 0.980"  = "#737373",
  "MCD Test Specificity > 0.990"  = "#595959",
  "MCD Test Specificity > 0.995" = "#404040"
)

ggplot() +
  geom_point(
    data  = psa_cloud,
    aes(x = Incremental_Utility,
        y = Incremental_Cost / 1e6,
        color = label_ce),
    size  = 2,
    alpha = 0.5
  ) +
  geom_hline(yintercept = 0, colour = "grey50") +
  geom_vline(xintercept = 0, colour = "grey50") +
  geom_abline(
    intercept = 0,
    slope     = wtp / 1e6,
    linetype  = "dashed",
    colour    = "black"
  ) +
  annotate("text",
           x = max(psa_cloud$Incremental_Utility, na.rm = TRUE) * 0.95,
           y = (wtp / 1e6) * max(psa_cloud$Incremental_Utility, na.rm = TRUE) * 0.95,
           label = paste0("WTP = $100,000/QALY"),
           hjust = 1.1,
           vjust = 0.5,
           size = 5,
           fontface = "italic") +
  scale_color_manual(
    values = setNames(bucket_colors[psa_ce_thresholds$label], psa_ce_thresholds %>%
                        mutate(label_ce = paste0(label, " (", round(pct_CE, 1), "% CE)")) %>%
                        pull(label_ce)),
    name = "Sampled Specificity Range (% Runs Cost Effective)"
  ) +
  scale_y_continuous(
    name = "Incremental Cost (millions USD)",
    labels = scales::dollar_format(prefix = "$", suffix = " M")
  ) +
  scale_x_continuous(
    name = "Incremental Utility (QALYs)",
    labels = scales::comma_format()
  ) +
  theme_classic() +
  theme(
    legend.position   = "right",
    panel.grid.major  = element_blank(),
    panel.grid.minor  = element_blank(),
    axis.title.x      = element_text(size = 18),
    axis.title.y      = element_text(size = 18),
    axis.text         = element_text(size = 14),
    legend.title      = element_text(size = 16),
    legend.text       = element_text(size = 14)
  )

