summarize_runset_main <- function(runs,
                                  uc_once = TRUE,
                                  uc_ref_name = "spec_0.98_cost_500",
                                  uc_label = "UC",
                                  mcd_label = "UC+MCD") {
  
  imap_dfr(runs, function(run_obj, run_name) {
    
    out <- list()
    
    # UC row (optionally only once, drawn from base-case object)
    if (!uc_once || identical(run_name, uc_ref_name)) {
      out <- append(out, list(
        main_summarize_run(run_obj,
                           run_name = paste0(run_name, " (", uc_label, ")"),
                           is_usual = TRUE)
      ))
    }
    
    # UC+MCD row (always)
    out <- append(out, list(
      main_summarize_run(run_obj,
                         run_name = paste0(run_name, " (", mcd_label, ")"),
                         is_usual = FALSE)
    ))
    
    bind_rows(out)
  })
}

summarize_runset_secondary <- function(runs,
                                       uc_once = TRUE,
                                       uc_ref_name = "spec_0.98_cost_500",
                                       uc_label = "UC",
                                       mcd_label = "UC+MCD") {
  
  imap_dfr(runs, function(run_obj, run_name) {
    
    out <- list()
    
    if (!uc_once || identical(run_name, uc_ref_name)) {
      out <- append(out, list(
        secondary_summarize_run(run_obj,
                                run_name = paste0(run_name, " (", uc_label, ")"),
                                is_usual = TRUE)
      ))
    }
    
    out <- append(out, list(
      secondary_summarize_run(run_obj,
                              run_name = paste0(run_name, " (", mcd_label, ")"),
                              is_usual = FALSE)
    ))
    
    bind_rows(out)
  })
}

