summarize_runset_main <- function(runs, uc_once = TRUE, uc_ref_name, uc_tag="(UC)", mcd_tag="(UC+MCD)") {
  purrr::imap_dfr(runs, function(run_obj, run_name) {
    
    rows <- list(
      main_summarize_run(run_obj, paste0(run_name, " ", mcd_tag), is_usual = FALSE)
    )
    
    if (!uc_once || identical(run_name, uc_ref_name)) {
      rows <- append(rows, list(
        main_summarize_run(run_obj, paste0(run_name, " ", uc_tag), is_usual = TRUE)
      ))
    }
    
    dplyr::bind_rows(rows)
  })
}

