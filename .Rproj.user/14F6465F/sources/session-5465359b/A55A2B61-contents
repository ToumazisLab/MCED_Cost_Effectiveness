## ------------------------------------------------------------
## Setup
## ------------------------------------------------------------
source("Global.R")
source("Functions/Preparation_Scripts/Def_params.R", echo = FALSE)
source("Functions/Preparation_Scripts/Source_file.R", echo = FALSE)
source("Functions/Shiny/run_model.R", echo = FALSE)

# You can still define this if you want a subset of cancers elsewhere,
# but for these runs we will use cancer_types_overall
cancer_types <- cancer_types_overall

# Core input parameters (will modify mced_test_cost within scenarios)
input_params <- list(
  mced_start_cycle       = 6,
  mced_end_cycle         = 41,
  mced_compliance_rate   = 0.75,
  overdiagnosis_factor   = 0.05,
  mced_test_cost         = 500,   # placeholder; will be overwritten in loop
  dwell_scenario         = "Scenario_2",
  ss_scenario            = 3,
  ts_matrix              = "time_shift_matrix_2",
  reduced_comply         = 1,
  fp_track_num           = 3,
  invasive_multi         = 0.1,   # must be between 0–1
  mced_fp_compliance     = 1,
  fp_disutility_val      = 0.0125,
  tn_disutility_val      = 0,
  d_c                    = 0.03,
  d_e                    = 0.03,
  active_slip            = FALSE,
  two_step               = FALSE,
  overall_sens           = 0,
  overall_specificity    = 0,
  mced_secondary_test_cost = 0
)

## ------------------------------------------------------------
## Load data + sensitivity
## ------------------------------------------------------------
data_loaded <- load_data(input_params, def_param_list)

sens_cancers <- cancer_types  # or use cancer_types_overall if your sensitivity file supports it

df_sensitivity <- readr::read_csv(
  "Data/overall/sensitivity_long_overall.csv",
  show_col_types = FALSE
) %>%
  dplyr::filter(Cancer %in% sens_cancers)

sensitivity_results <- process_sensitivity(
  cancer_list      = sens_cancers,
  sensitivity_long = df_sensitivity,
  seer_draw        = data_loaded$seer_draw,
  xStage           = def_param_list$xStage,
  active_slip      = FALSE,
  dwell_model_df   = data_loaded$dwell_model_all_cancers
)

sensitivity_processed <- sensitivity_results$sensitivity_long
sensitivity_matrix    <- sensitivity_results$Values

## ------------------------------------------------------------
## Scenario design: screening vs non-screening specificity + test cost
## ------------------------------------------------------------

# Cancers for full model runs
all_cancers           <- cancer_types_overall
screening_cancers     <- def_param_list$screening_cancers
nonscreen_cancers     <- setdiff(all_cancers, screening_cancers)

# Grid of values:
screening_spec_vals   <- c(0.97, 0.98, 0.99)
nonscreen_spec_vals   <- c(0.98, 0.99)  # narrower & higher
mced_test_cost_vals   <- c(100, 500, 750)

scenario_grid <- expand.grid(
  screening_spec   = screening_spec_vals,
  nonscreen_spec   = nonscreen_spec_vals,
  mced_test_cost   = mced_test_cost_vals,
  stringsAsFactors = FALSE
)

## ------------------------------------------------------------
## Run scenarios
## ------------------------------------------------------------

scenario_results <- vector("list", nrow(scenario_grid))
scenario_names   <- character(nrow(scenario_grid))

for (i in seq_len(nrow(scenario_grid))) {
  scr_spec  <- scenario_grid$screening_spec[i]
  ns_spec   <- scenario_grid$nonscreen_spec[i]
  test_cost <- scenario_grid$mced_test_cost[i]
  
  # Update input params for this scenario
  this_input_params <- input_params
  this_input_params$mced_test_cost <- test_cost
  
  # Build specificity dataframe: one row per cancer in ALL cancers
  specificity_df <- data.frame(
    Cancer = all_cancers,
    stringsAsFactors = FALSE
  ) %>%
    dplyr::mutate(
      Specificity = dplyr::case_when(
        Cancer %in% screening_cancers ~ scr_spec,
        TRUE                          ~ ns_spec
      )
    )
  
  # Create a readable scenario name
  scen_name <- paste0(
    "scr_",  sprintf("%g", scr_spec),
    "_nonscr_", sprintf("%g", ns_spec),
    "_cost_", test_cost
  )
  
  message("Running scenario ", i, "/", nrow(scenario_grid), ": ", scen_name)
  
  scenario_results[[i]] <- run_usual_model(
    cancer_list          = all_cancers,
    data_list            = data_loaded,
    def_param_list       = def_param_list,
    input_params         = this_input_params,
    sensitivity_long     = df_sensitivity,
    specificity_data     = specificity_df,
    Values               = sensitivity_matrix,
    cancer_types_overall = cancer_types_overall
  )
  
  scenario_names[i] <- scen_name
}

names(scenario_results) <- scenario_names

## Optional: attach the parameter grid for easy reference
attr(scenario_results, "scenario_grid") <- scenario_grid
