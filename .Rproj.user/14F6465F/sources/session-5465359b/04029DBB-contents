## ── 2. Define the WTP grid ─────────────────────────────────────────────
wtp_grid <- seq(0, 300000, by = 1000)  # 0–100k in 5-k increments

#### ── 3. Calculate CEAC for both strategies ─────────────────────────────####
ceac_df <- map_dfr(
  wtp_grid,
  function(w){
    psa_out_final %>% 
      # Net-monetary benefit for each strategy
      mutate(NMB_MCED =  w * mced_utility  - mced_cost,
             NMB_UC   =  w * usual_utility - usual_cost,
             Best     =  case_when(
               NMB_MCED > NMB_UC ~ "MCED",
               NMB_MCED < NMB_UC ~ "Usual care",
               TRUE              ~ "Tie"
             )) %>% 
      summarise(
        WTP     = w,
        MCED    = mean(Best == "MCED"),
        UC      = mean(Best == "Usual care")
      )
  }
) %>% 
  pivot_longer(cols = c(MCED, UC),
               names_to   = "Strategy",
               values_to  = "Prob_CE")

ceac_df_98 <- map_dfr(
  wtp_grid,
  function(w){
    psa_out_final %>%
      left_join(psa_design_final, by = "run_id") %>%  # safer merge
      filter(all_spec >= 0.98) %>% 
      mutate(NMB_MCED =  w * mced_utility  - mced_cost,
             NMB_UC   =  w * usual_utility - usual_cost,
             Best     =  case_when(
               NMB_MCED > NMB_UC ~ "MCED ≥ 0.98",
               NMB_MCED < NMB_UC ~ "Usual care",
               TRUE              ~ "Tie"
             )) %>% 
      summarise(
        WTP         = w,
        `MCED ≥ 0.98` = mean(Best == "MCED ≥ 0.98"),
        `Usual care`  = mean(Best == "Usual care")
      )
  }
) %>%
  pivot_longer(cols = c(`MCED ≥ 0.98`, `Usual care`),
               names_to   = "Strategy",
               values_to  = "Prob_CE")


