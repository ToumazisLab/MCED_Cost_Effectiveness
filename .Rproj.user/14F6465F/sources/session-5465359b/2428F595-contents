make_spec_df <- function(clist, spec_val) {
  data.frame(Cancer = clist, Specificity = rep(spec_val, length(clist)))
}

vals_for <- function(clist) {
  V <- sensitivity_matrix
  if (!is.null(rownames(V))) {
    V[rownames(V) %in% clist, , drop = FALSE]
  } else {
    V
  }
}

run_model_scenario <- function(clist, spec_val, cost_val) {
  run_usual_model(
    cancer_list          = clist,
    data_list            = data_loaded,
    def_param_list       = def_param_list,
    input_params         = modifyList(input_params, list(mced_test_cost = cost_val)),
    sensitivity_long     = df_sensitivity[df_sensitivity$Cancer %in% clist, , drop = FALSE],
    specificity_data     = make_spec_df(clist, spec_val),
    Value               = vals_for(clist),
    cancer_types_overall = cancer_types_overall
  )
}

