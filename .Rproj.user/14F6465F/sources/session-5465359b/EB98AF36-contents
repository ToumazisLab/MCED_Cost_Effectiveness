sweep_thresholds_custom <- function(model, base_vals, sweep_params, threshold = 0.5) {
  results <- list()
  
  for (param in names(sweep_params)) {
    message("Sweeping ", param)
    
    sweep_vals <- sweep_params[[param]]
    
    # Repeat base values and override the current parameter
    test_df <- as.data.frame(matrix(rep(unlist(base_vals), each = length(sweep_vals)), 
                                    nrow = length(sweep_vals), byrow = FALSE))
    colnames(test_df) <- names(base_vals)
    test_df[[param]] <- sweep_vals
    
    # Predict
    mat <- as.matrix(test_df)
    colnames(mat) <- colnames(X_mat_train)
    probs <- predict(model, newdata = mat)
    
    # Find first crossing above threshold
    threshold_idx <- which(probs > threshold)[1]
    threshold_val <- if (!is.na(threshold_idx)) sweep_vals[threshold_idx] else NA
    
    results[[param]] <- list(
      threshold_value = threshold_val,
      sweep_values    = sweep_vals,
      probs           = probs
    )
  }
  
  return(results)
}

threshold_results <- sweep_thresholds_custom(
  model        = xgb_mod,
  base_vals    = base_vals,
  sweep_params = sweep_params,
  threshold    = 0.5
)


df_all <- map_dfr(
