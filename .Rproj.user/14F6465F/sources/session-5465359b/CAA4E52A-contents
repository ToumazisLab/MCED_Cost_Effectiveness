  validate_before_run <- function() {
    errs <- character(0)
    
    # 1) Must have at least one cancer
    if (!cancers_selected()) {
      errs <- c(errs, "Select at least one cancer.")
    }
    
    # 2) Sensitivity monotonic & within [0,1]
    sens_msg <- validate_sens_order()
    if (!is.null(sens_msg)) errs <- c(errs, sens_msg)
    
    sens_df <- tryCatch(reactive_sens_values(), error = function(e) NULL)
    if (is.null(sens_df) || any(is.na(sens_df$Sensitivity))) {
      errs <- c(errs, "Sensitivity has missing values.")
    } else {
      if (any(sens_df$Sensitivity < 0 | sens_df$Sensitivity > 1, na.rm = TRUE)) {
        errs <- c(errs, "Sensitivity must be between 0 and 1.")
      }
    }
    
    # 3) Specificity present and in (EPS, 1]
    spec_df_now <- reactive_spec_values()
    if (is.null(spec_df_now) || any(is.na(spec_df_now$Specificity))) {
      errs <- c(errs, "Specificity has missing values.")
    } else if (any(spec_df_now$Specificity <= EPS | spec_df_now$Specificity > 1)) {
      errs <- c(errs, sprintf("Specificity must be > %.6f and ≤ 1.0.", EPS))
    }
    
    # 4) Cost sanity
    cost <- suppressWarnings(as.numeric(input$mced_test_cost))
    if (is.na(cost) || cost < 0) {
      errs <- c(errs, "MCD test cost must be a number ≥ 0.")
    }
    
    k <- input$fp_track_num
    max_k <- length(input$selected_cancers)
    if (is.null(k) || is.na(k) || k < 0 || k > max_k) {
      errs <- c(errs, sprintf("Max FPs to follow up must be between 0 and %d (number of selected cancers).", max_k))
    }
    
    errs
  }
  
  
