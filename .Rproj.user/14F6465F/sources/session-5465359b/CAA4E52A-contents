              "Cost: $", scales::comma(Cost, accuracy = 1)
            )
          )) +
            geom_col(aes(color = Bucket), linewidth = df_cost$border_size) +
            scale_fill_manual(name = "Cost Category", values = fill_colors) +
            scale_color_manual(
              values = c(
                "Test Cost"           = "black",
                "Imaging Cost"        = NA,
                "Diagnostic Cost"     = NA,
                "Invasive Cost"       = NA,
                "Post Diagnosis Costs"= NA
              ),
              guide = "none"
            ) +
            xlab("Cost Category") +
            scale_y_continuous(
              labels = scales::dollar_format(accuracy = 1)
            ) +
            ylab("Total Cost") +
            ggtitle(paste0("MCD Cost Breakdown – ", selected_cancer, " – ", selected_group)) +
            theme_minimal() +
            theme(
              legend.title   = element_text(size = 11, face = "bold"),
              legend.text    = element_text(size = 10),
              legend.position= "right",
              axis.text.x = element_text(angle = 45, vjust = 0.5)
            )
          
          ggplotly(p, tooltip = "text")
        })
        
        
        output[[paste0("test_cost_note_", run_index)]] <- renderUI({
          selected_cancer <- input[[paste0("cost_cancer_select_", run_index)]]
          
          if (!is.null(selected_cancer) && selected_cancer != "All Cancers") {
            tags$p(
              style = "color:red; font-style:italic; font-size: 90%; margin-top: 5px;",
              "Note: The MCD test cost is incurred once across all cancers and shown here for context."
            )
          } else {
            NULL
          }
        })
        
        output[[paste0("case_plot_controls_", run_index)]] <- renderUI({
          req(run_data$overall_summary)
          
          available_cancers <- unique(run_data$overall_summary$Cancer)
          cancer_choices <- c("All Cancers", sort(available_cancers))
          
          tagList(
            fluidRow(
              column(
                6,
                selectInput(
                  inputId  = paste0("selected_cancer_type_", run_index),
                  label    = "Select Cancer Type",
                  choices  = cancer_choices,
                  selected = "All Cancers"
                )
              ),
              column(
                6,
                selectInput(
                  inputId  = paste0("selected_case_type_", run_index),
                  label    = "Select Case Type",
                  choices  = c("MCED TP", "MCED FN", "MCED NC", "Usual Care", "Overall"),
                  selected = "Overall"
                )
              )
            )
          )
        })
        
        output[[paste0("case_category_plot_", run_index)]] <- renderPlotly({
          req(run_data$overall_summary)
          
          cancer_id <- paste0("selected_cancer_type_", run_index)
          case_id   <- paste0("selected_case_type_", run_index)
          
          req(input[[cancer_id]], input[[case_id]])
          
          df <- make_bar_df_v3(
            overall_summary = run_data$overall_summary,
            cancer_type     = input[[cancer_id]]
          )
          
          if (input[[case_id]] != "Overall") {
            df <- dplyr::filter(df, CaseType == input[[case_id]])
          }
          
          build_case_plot_v3(df)
        })
        
        local({
          plot_id <- paste0("case_category_plot_", run_index)
          outputOptions(output, plot_id, suspendWhenHidden = FALSE)
        })
        
        output[[paste0("overdx_plot_controls_", run_index)]] <- renderUI({
          req(run_data$overall_summary)
          available_cancers <- unique(run_data$overall_summary$Cancer)
          cancer_choices <- c("All Cancers", sort(available_cancers))
          
          selectInput(paste0("selected_overdx_cancer_", run_index),
                      "Select Cancer Type",
                      choices = cancer_choices,
                      selected = "All Cancers")
        })
        
        output[[paste0("overdx_plot_", run_index)]] <- renderPlotly({
          req(run_data$overall_summary)
          req(input[[paste0("selected_overdx_cancer_", run_index)]])
          
          build_overdx_deaths_plot_v2(
            overall_summary = run_data$overall_summary,
            selected_cancer = input[[paste0("selected_overdx_cancer_", run_index)]]
          )
        })
        
      })
    }
  })
  
  output$summary_ce_table <- renderDT({
    req(input$wtp_threshold)  # ensure input is available
    
    df <- runs_df()
    if (nrow(df) == 0) return(DT::datatable(data.frame()))
    
    wtp <- as.numeric(input$wtp_threshold)
    
    df <- df %>%
      mutate(
        `Incremental Cost (M)` = round(inc_cost / 1e6, 0),
        `Incremental QALYs`    = round(inc_utility, 0),
        `ICER ($/per QALY)` = case_when(
          inc_cost > 0 & inc_utility < 0 ~ "Dominated by UC",
          inc_utility > 0                ~ scales::label_currency()(ICER),
          TRUE                           ~ NA_character_
        ),
        `Cost-Effective`       = ifelse(ICER <= wtp & inc_utility > 0, "Yes", "No"),
        `True Positives`       = round(TP, 0),
        `False Negatives`      = round(FN, 0),
        `False Positives`      = round(FP, 0),
        `True Negative`        = round(TN, 0),
        `Deaths Averted`       = round(Deaths_averted, 0)
      ) %>%
      select(
        Run = run_label,
        `Incremental Cost (M)`,
        `Incremental QALYs`,
        `ICER ($/per QALY)`,
        `Cost-Effective`,
        `True Positives`,
        `False Negatives`,
        `True Negative`,
        `False Positives`,
        `Deaths Averted`
      )
    
    datatable(
      df,
      rownames = FALSE,
      options = list(
        dom = 't',
        ordering = FALSE,
        pageLength = 10,
        scrollX = TRUE,
        columnDefs = list(
          list(
            targets = 4,
            render = JS(
              "function(data, type, row, meta) {
              if (type === 'display') {
                var bg = (data === 'Yes') ? '#d4edda' : '#f8d7da';
                return '<div style=\"background-color:' + bg + '; padding:5px; border-radius:4px; text-align:center;\">' + data + '</div>';
              }
              return data;
            }"
            )
          )
        )
      )
    )
  })
  
  
  output$ce_summary_box <- renderUI({
    req(input$wtp_threshold)
    
    box(
      title = paste0("Cost-Effectiveness Summary Table (WTP: $", scales::comma(as.numeric(input$wtp_threshold)), " per QALY)"),
      status = "info",
      width = 12,
      DTOutput("summary_ce_table")
    )
  })
}
