y_test_fac  <- factor(y_test,  levels = c(FALSE, TRUE))

# =============== XGBOOST ===============
# Matrix inputs
X_train_mat <- as.matrix(X_train_clean)
X_test_mat  <- as.matrix(X_test_clean)

dtrain <- xgb.DMatrix(data = X_train_mat, label = y_train_fac)
dtest  <- xgb.DMatrix(data = X_test_mat,  label = y_test_fac)

# # Small tuning grid (expand if you want more thorough search)
xgb_grid <- expand.grid(
  eta = c(0.05, 0.1),
  max_depth = c(3, 5, 7),
  min_child_weight = c(1, 5),
  subsample = c(0.8, 1.0),
  colsample_bytree = c(0.8, 1.0)
)
#
cv_nrounds <- 1000
early_stopping <- 25
best <- NULL

for (i in seq_len(nrow(xgb_grid))) {
  prm <- xgb_grid[i, ]
  params <- list(
    objective = "binary:logistic",
    eval_metric = "auc",
    eta = prm$eta,
    max_depth = prm$max_depth,
    min_child_weight = prm$min_child_weight,
    subsample = prm$subsample,
    colsample_bytree = prm$colsample_bytree,
    nthread = 0
  )
  cv <- xgb.cv(
    params = params,
    data = dtrain,
    nrounds = cv_nrounds,
    nfold = 5,
    stratified = TRUE,
    showsd = FALSE,
    verbose = 0,
    early_stopping_rounds = early_stopping,
    maximize = TRUE
  )
  score <- max(cv$evaluation_log$test_auc_mean)
  best_iter <- cv$best_iteration
  cand <- list(params = params, score = score, best_iter = best_iter)
  if (is.null(best) || cand$score > best$score) best <- cand
}
