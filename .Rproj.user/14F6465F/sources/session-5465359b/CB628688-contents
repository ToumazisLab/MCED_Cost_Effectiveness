base_long <- read_csv("mcd_base_values.csv", show_col_types = FALSE)

base_map <- base_long %>%
  mutate(
    param_name = janitor::make_clean_names(param_name),
    base_value = as.numeric(base_value)   # force numeric
  ) %>%
  select(param_name, base_value) %>%
  deframe()

features <- colnames(X_train_clean)  # the features your models expect (already clean_names())

# Build a single-row base vector for *all* features the model needs.
# If a feature isn't in base_map, we fall back to the *training* column mean.
base_row <- as_tibble(as.list(setNames(rep(NA_real_, length(features)), features)))

for (nm in features) {
  if (nm %in% names(base_map)) {
    base_row[[nm]] <- as.numeric(base_map[[nm]])
  } else if (nm %in% names(X_train_clean)) {
    val <- suppressWarnings(mean(X_train_clean[[nm]], na.rm = TRUE))
    base_row[[nm]] <- ifelse(is.na(val), 0, val)
  } else {
    base_row[[nm]] <- 0
  }
}

# --- 2) Define the sequences for the three knobs ---
spec_seq <- unique(c(seq(0.98, 0.999, by = 0.005), 0.9999))
sens_seq <- seq(0.75, 1.25, by = 0.05)          # adjust if you want a finer grid
cost_seq <- seq(50, 1000, by = 50)

grid <- tidyr::crossing(
  all_spec = spec_seq,
  all_sens = sens_seq,
  mced_test_cost = cost_seq
)

# --- 3) Build a prediction frame: replicate base row and overwrite the 3 columns per grid ---
# Guard: ensure the three columns exist in your features
needed <- c("all_spec", "all_sens", "mced_test_cost")
missing_needed <- setdiff(needed, features)
if (length(missing_needed) > 0) {
  stop(paste("These required features are missing from your training matrix:",
             paste(missing_needed, collapse = ", ")))
}

# Replicate the base row as many times as there are rows in grid
base_mat <- base_row[rep(1, nrow(grid)), ]

# Overwrite the three varying columns with grid values
pred_df <- base_mat %>%
  mutate(
    all_spec       = grid$all_spec,
    all_sens       = grid$all_sens,
    mced_test_cost = grid$mced_test_cost
  )

# --- 4) Predict probabilities with both models ---
# XGBoost expects a matrix
X_mat_pred <- as.matrix(pred_df[, features, drop = FALSE])
pred_xgb <- as.numeric(predict(xgb_mod, newdata = X_mat_pred))

# Random forest probabilities (assumes y was factor with "TRUE"/"FALSE")
pred_rf_probs <- predict(rf_mod, newdata = pred_df[, features, drop = FALSE], type = "prob")
# Get probability of CE == TRUE; adjust the column name if your positive class label differs
rf_true_col <- if ("TRUE" %in% colnames(pred_rf_probs)) "TRUE" else colnames(pred_rf_probs)[2]
pred_rf <- as.numeric(pred_rf_probs[, rf_true_col])

# Simple ensemble (optional)
pred_ens <- (pred_xgb + pred_rf) / 2

# --- 5) Assemble results and save ---
results <- grid %>%
  mutate(
    p_ce_xgb = pred_xgb,
    p_ce_rf  = pred_rf,
    p_ce_avg = pred_ens
  )


