# Function for metrics
get_metrics <- function(model_name, truth, pred_class) {
  tibble(
    Model = model_name,
    Accuracy    = yardstick::accuracy_vec(truth, pred_class),
    F1          = yardstick::f_meas_vec(truth, pred_class),
    Sensitivity = yardstick::sens_vec(truth, pred_class),
    Specificity = yardstick::spec_vec(truth, pred_class)
  )
}

# Apply
results_table <- bind_rows(
  get_metrics("Random Forest", truth, pred_rf_cls),
  get_metrics("XGBoost", truth, pred_xgb_cls)
) %>%
  mutate(across(-Model, ~ round(.x, 2)))

print(results_table)
