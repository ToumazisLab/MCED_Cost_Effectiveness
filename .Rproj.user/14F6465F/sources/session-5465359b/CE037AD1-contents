get_overdx_long <- function() {
  bind_rows(lapply(cancer_types_overall, function(cancer) {
    df <- baseline_list[["98%"]][["final_result_list"]][["MCED"]][[cancer]][["MCED_Cancer_cases"]]
    df <- df[, grepl("^overdiagnosed_", colnames(df))]
    df$cycle <- seq_len(nrow(df))
    df_long <- pivot_longer(df, cols = starts_with("overdiagnosed_"),
                            names_to = "stage", values_to = "n_cases")
    df_long$stage <- gsub("overdiagnosed_", "", df_long$stage)
    df_long$cancer_type <- cancer
    df_long
  }))
}

df_overdx <- get_overdx_long()

df_overdx_summary <- df_overdx %>%
  group_by(stage) %>%
  summarise(n_cases = sum(n_cases), .groups = "drop") %>%
  mutate(
    source_stage = NA_character_,  # No source
    target_stage = stage,
    source_label = NA_character_,
    target_label = paste("Overdiagnosed:", stage)
  )

df_overdx_link <- df_overdx_summary %>%
  select(source_label, target_label, n_cases)

df_alluvial_extra <- bind_rows(df_plot %>%
                                 select(source_label, target_label, n_cases),
                               df_overdx_link) %>%
  rename(Stage = source_label, Stage2 = target_label, freq = n_cases)

