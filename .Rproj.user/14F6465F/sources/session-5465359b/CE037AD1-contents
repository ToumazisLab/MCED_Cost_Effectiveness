library(ggplot2)
library(ggalluvial)
library(dplyr)
library(scales)

# 1) Get the data
df_sankey <- baseline$sankey_df_all   # baseline_list[["98%"]][["sankey_df_all"]]

# 2) Aggregate across cancers for "All Cancers"
df_link <- df_sankey %>%
  group_by(source_stage, target_stage) %>%
  summarise(n_cases = sum(n_cases), .groups = "drop")

# 3) Recode for plotting
df_plot <- df_link %>%
  mutate(
    source_label = paste("UC:", source_stage),
    target_label = paste("MCD + UC:", target_stage)
  )

df_alluvial <- df_plot %>%
  select(source_label, target_label, n_cases) %>%
  rename(Stage = source_label, Stage2 = target_label, freq = n_cases)

# Define a manual greyscale palette for Usual Care stages
grey_fill <- c(
  "Stage I"   = "#1b9e77",  # green
  "Stage II"  = "#7570b3",  # blue-violet
  "Stage III" = "#e6ab02",  # goldenrod
  "Stage IV"  = "#d95f02"   # orange
)

# Plot
ggplot(df_alluvial,
       aes(axis1 = Stage, axis2 = Stage2, y = freq)) +
  geom_alluvium(aes(fill = Stage), width = 1/12, color = "grey40") +
  geom_stratum(width = 2/12, fill = "grey95", color = "grey30") +
  geom_text(
    stat = "stratum",
    aes(label = paste0(stratum, "\n", comma(after_stat(y)))),
    size = 3.5
  ) +
  scale_fill_manual(values = grey_fill, name = "Usual Care Stage") +
  scale_x_discrete(limits = c("Usual Care", "MCD + UC"), expand = c(.1, .05)) +
  scale_y_continuous(labels = comma) +
  theme_minimal(base_size = 15) +
  theme(panel.grid = element_blank()) +
  labs(
    y = "Number of Cases",
    x = NULL
  )

