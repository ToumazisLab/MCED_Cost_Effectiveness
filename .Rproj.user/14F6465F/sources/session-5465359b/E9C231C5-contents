get_stage_distribution_by_cancer <- function(matrix) {
  stage_counts <- colSums(matrix, na.rm = TRUE)
  
  tibble(
    Stage  = sub("_.*", "", names(stage_counts)),
    Cancer = sub(".*_", "", names(stage_counts)),
    Count  = stage_counts
  ) %>%
    group_by(Cancer) %>%
    mutate(Proportion = Count / sum(Count)) %>%
    ungroup() %>%
    select(Cancer, Stage, Proportion)
}

summarize_by_cancer <- function(run_obj, run_name, is_usual = FALSE) {
  icer_df <- run_obj[["final_result_list"]][["Overall"]][["final_icer_result"]]
  summary_df <- run_obj[["overall_summary"]]
  
  if (is_usual) {
    cost <- icer_df$Value[icer_df$Variable == "usual_cost"]
    qalys <- icer_df$Value[icer_df$Variable == "usual_utility"]
    inc_cost <- 0
    inc_qalys <- 0
    icer <- 0
    stage_df <- get_stage_distribution_by_cancer(run_obj[["incident_matrix_trimmed"]])
    deaths_averted <- summary_df %>%
      filter(Arm == "uc", Variable == "Cancer_deaths") %>%
      group_by(Cancer) %>% summarise(Value = 0, .groups = "drop")
    overdx <- tibble(Cancer = unique(summary_df$Cancer), Value = 0)
    
    fp1 <- summary_df %>%
      filter(Arm == "uc", Variable == "UC_FPx1") %>%
      select(Cancer, `FPs (Count)` = Value)
    fp2 <- summary_df %>%
      filter(Arm == "uc", Variable == "UC_FPx2") %>%
      select(Cancer, `FPs (Test Results)` = Value)
    fp_df <- full_join(fp1, fp2, by = "Cancer") %>%
      mutate(across(where(is.numeric), ~replace_na(.x, 0)))
    
  } else {
    cost <- icer_df$Value[icer_df$Variable == "mced_cost"]
    qalys <- icer_df$Value[icer_df$Variable == "mced_utility"]
    inc_cost <- icer_df$Value[icer_df$Variable == "Incremental_Cost"]
    inc_qalys <- icer_df$Value[icer_df$Variable == "Incremental_Utility"]
    icer <- icer_df$Value[icer_df$Variable == "ICER"]
    stage_df <- get_stage_distribution_by_cancer(run_obj[["mced_incident_matrix"]])
    deaths_averted <- summary_df %>%
      filter(Arm == "m_v_uc", Variable == "Cancer_deaths_averted") %>%
      mutate(Value = pmax(0, Value)) %>%
      select(Cancer, Value)
    overdx <- summary_df %>%
      filter(Arm == "m", Variable == "overdx_Total") %>%
      select(Cancer, Value)
    
    cancer_names <- names(run_obj[["final_result_list"]][["MCED"]])
    fp_df <- purrr::map_dfr(cancer_names, function(ca) {
      list_data <- run_obj[["final_result_list"]][["MCED"]][[ca]][["mced_TN_FP"]]
      tibble(
        Cancer = ca,
        `FPs (Count)` = safe_sum(list_data[["FP_fu"]]),
        `FPs (Test Results)` = safe_sum(list_data[["FP_fu"]])
      )
    })
  }
  
  # Join all metrics by cancer
  out <- stage_df %>%
    pivot_wider(names_from = Stage, values_from = Proportion, values_fill = 0) %>%
    rename(
      `Stage I` = I, `Stage II` = II, `Stage III` = III, `Stage IV` = IV
    ) %>%
    left_join(deaths_averted, by = "Cancer") %>%
    rename(`Cancer Deaths Averted` = Value) %>%
    left_join(overdx, by = "Cancer") %>%
    rename(`Cases Overdiagnosed` = Value) %>%
    left_join(fp_df, by = "Cancer") %>%
    mutate(
      Run = run_name,
      Cost = cost,
      QALYs = qalys,
      `Incremental Cost` = inc_cost,
      `Incremental Utility` = inc_qalys,
      ICER = icer
    ) %>%
    select(Run, Cancer, everything())
  
  return(out)
}

