two_rows_bounded <- function(name, base, pct = 0.25) {
  tibble(
    param_name  = name,
    change_type = c("minus","plus"),
    new_value   = c(base*(1-pct), base*(1+pct)) |>
      pmin(1) |> pmax(0)  # clamp to [0,1]
  )
}

two_rows_unbounded <- function(name, base, pct = 0.25) {
  tibble(
    param_name  = name,
    change_type = c("minus","plus"),
    new_value   = c(base*(1-pct), base*(1+pct))
  )
}

