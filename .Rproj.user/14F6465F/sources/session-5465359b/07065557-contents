    n_cycles            = nrow(m_count_shifted_TP),
    col_names           = colnames(m_count_shifted_TP),
    survival_method     = input_params$survival_method    # "floor_max" (Approach 1); "add_shift" (Approach 2)
  )
  m_post_diagnosis_tp       <- tp_pd$total_costs_incidence
  m_survival_years_tp       <- tp_pd$survival_df
  m_deaths_tp               <- tp_pd$deaths
  m_utility_cancers_wide_tp <- tp_pd$qaly_wide
  transition_table          <- tp_pd$transition_table
  
  # FN + NA deaths / QALYs (unchanged)
  m_deaths_fn <- as.matrix(calculate_deaths_by_cancer_stage(m_count_FN,
                                                            data_list$transposed_survival))
  
  m_utility_cancers_fn <- calculate_total_qalys(m_count_FN,
                                                data_list$transposed_survival,
                                                data_list$utility_long,
                                                data_list$expanded_utility)
  
  m_utility_cancers_wide_fn <- pivot_wider(m_utility_cancers_fn, names_from = Cancer_Stage, values_from = QALYs, values_fill = list(QALYs = 0))
  m_utility_cancers_wide_fn <- as.data.frame(m_utility_cancers_wide_fn[, -(c(1))])
  
  m_deaths_na <- as.matrix(calculate_deaths_by_cancer_stage(m_count_mced_NA,
                                                            data_list$transposed_survival))
  
  m_utility_cancers_na <- calculate_total_qalys(m_count_mced_NA,
                                                data_list$transposed_survival,
                                                data_list$utility_long,
                                                data_list$expanded_utility)
  
  m_utility_cancers_wide_na <- pivot_wider(m_utility_cancers_na, names_from = Cancer_Stage, values_from = QALYs, values_fill = list(QALYs = 0))
  m_utility_cancers_wide_na <- as.data.frame(m_utility_cancers_wide_na[, -(c(1))])
  
  
  final_result_list <- update_post_diagnosis_survival_deaths_utility(final_result_list,
                                                                     m_post_diagnosis_tp,
                                                                     m_survival_years_tp,
                                                                     m_deaths_tp,
                                                                     m_utility_cancers_wide_tp,
                                                                     arm = "MCED",
                                                                     group = "TP")
  
  final_result_list <- update_post_diagnosis_survival_deaths_utility(final_result_list,
                                                                     m_post_diagnosis_fn,
                                                                     m_survival_years_fn,
                                                                     m_deaths_fn,
                                                                     m_utility_cancers_wide_fn,
                                                                     arm = "MCED",
                                                                     group = "FN")
  
  final_result_list <- update_post_diagnosis_survival_deaths_utility(final_result_list,
                                                                     m_post_diagnosis_na,
                                                                     m_survival_years_na,
                                                                     m_deaths_na,
                                                                     m_utility_cancers_wide_na,
                                                                     arm = "MCED",
                                                                     group = "NA")
  
  mced_incident_matrix <- m_count_shifted_TP + m_count_FN + m_count_mced_NA
  
  m_cancer_deaths    <- summarize_cancer_deaths(mced_incident_matrix, data_list$survival_expanded)
  m_cancer_deaths_TP <- summarize_cancer_deaths(m_count_shifted_TP, data_list$survival_expanded)
  m_cancer_deaths_FN <- summarize_cancer_deaths(m_count_FN, data_list$survival_expanded)
  m_cancer_deaths_NC <- summarize_cancer_deaths(m_count_mced_NA, data_list$survival_expanded)
  
  #### MCED: TN/FP ####
  ## DEPENDENCY: input_params: mced_compliance_rate
  # MCED TNs and FPs using probabilities
  H_compliant <- generate_compliant_vector(incident_matrix,
                                           input_params$mced_compliance_rate,
                                           input_params$mced_start_cycle,
                                           input_params$mced_end_cycle)
  H_vector <- H_compliant$H_vector
  compliant_vector <- H_compliant$compliant_vector
  
  ## DEPENDENCY: if specificity != data_list$specificity
  ## input_params: fp_track_num
  updated_results <- run_all_cycles(
    compliant_vector = compliant_vector,
    H_vector = H_vector,
    female_prop = def_param_list$female_prop,
    fp_track_num = input_params$fp_track_num,
    specificity_df = specificity_data,
    cancer_list = cancer_list,
    female_cancers = def_param_list$female_cancers,
    male_cancers = def_param_list$male_cancers,
    final_result_list = final_result_list,
    two_step = input_params$two_step,
    overall_specificity = input_params$overall_specificity,
    incident_matrix_trimmed = mced_incident_matrix     # <-- NEW argument
  )
  
  final_result_list <- updated_results$final_result_list
  
  ## DEPENDENCY: input_params: mced_fp_compliance
  final_result_list <- mced_fp_usual_compliance(final_result_list,
                                                cancer_list,
                                                mced_fp_compliance = input_params$mced_fp_compliance)
  
  ## DEPENDENCY: input_params: tn_skip_years
  # IV. Calculate MCED Usual Care
  final_result_list <- apply_mced_usual_care_and_costs(final_result_list,
                                                       data_list$screening_fp_diag_costs,
                                                       discount_factor = input_params$d_c,
                                                       screening_cancers,
                                                       tn_skip_factor = input_params$reduced_comply,
                                                       invasive_multiplier = input_params$invasive_multi)
  
  final_result_list <- summarize_overall_results(final_result_list)
  
  ## MCED Non-compliant (1-mced_compliance_rate * usual care values for FP, TN, Invasive, FP_imaging, FP_diagnostic, TN_imaging, Invasive costs)
  final_result_list <- apply_mced_nc_calculations(final_result_list,
                                                  data_list$screening_fp_diag_costs,
                                                  input_params$d_c,
                                                  input_params$mced_compliance_rate)
  
  ## MCED Test Cost
  final_result_list <- apply_mced_test_cost(final_result_list,
                                            input_params$mced_test_cost,
                                            input_params$mced_secondary_test_cost,
                                            input_params$d_c)
  
  ### MCED TN/FP Utility
  final_result_list <- calculate_mced_utility(final_result_list,
                                              data_list$expanded_utility,
                                              fp_disutility = input_params$fp_disutility_val,
                                              def_param_list$female_cancers,
                                              def_param_list$male_cancers,
                                              def_param_list$female_prop)
  
  
  
  final_result_list <- sum_mced_usual_costs(final_result_list)
  final_result_list <- calculate_icer(final_result_list)
  
  overall_summary <- generate_full_long_df(final_result_list, cancer_list,
                                           m_cancer_deaths, uc_cancer_deaths, final_screen_df)
  
  return(list(final_result_list = final_result_list, mced_incident_matrix = mced_incident_matrix,
              incident_matrix_trimmed = incident_matrix_trimmed, sankey_df_all = sankey_df_all,
              overall_summary = overall_summary, final_screen_df_stage = final_screen_df_stage,
              m_cancer_deaths_TP = m_cancer_deaths_TP, m_cancer_deaths_FN = m_cancer_deaths_FN,
              m_cancer_deaths_NC = m_cancer_deaths_NC, m_cancer_deaths = m_cancer_deaths,
              uc_cancer_deaths = uc_cancer_deaths, final_screen_df = final_screen_df,
              transition_table = transition_table))
}


run_one <- function(design_row,
                    base_params,
                    base_data,
                    df_sensitivity,
                    original_specificity,
                    sensitivity_matrix,
                    def_param_list,
                    cancer_types_overall,
                    result_dir) {
  
  cat(glue::glue("\nNow running scenario: {design_row$run_id} ",
                 "({design_row$param_name} – {design_row$change_type})\n"))
  
  # 5A. Copy base params/data locally
  ip <- base_params
  dl <- base_data
  get_scalar <- function(x) as.numeric(x[[1]])
  
  # 5B. Prepare local versions of sens/spec
  multiplier <- as.numeric(design_row$new_value)
  local_sens <- df_sensitivity
  local_spec <- original_specificity
  
  # 5C. Adjust sensitivity if needed
  if (design_row$label == "all_sens_plus" ||
      design_row$label == "all_sens_minus") {
    
    local_sens <- local_sens %>%
      mutate(
        Sensitivity = Sensitivity * multiplier,
        Sensitivity = pmin(0.99, pmax(0, Sensitivity))
      )
  }
  
  # 5D. Adjust specificity if needed
  if (design_row$label == "all_spec_minus" ||
      design_row$label == "all_spec_plus") {
    
    local_spec <- local_spec %>%
      mutate(
        Specificity = multiplier,
        Specificity = pmin(0.9999999999, pmax(0, Specificity))
      )
  }
  
  # 5E. Adjust cost per year by stage
  if (grepl("^stage_cost_", design_row$param_name)) {
    target_stage <- sub("stage_cost_", "", design_row$param_name)
    dl$cost_per_year <- cpy_mult_one_stage(
      df = dl$cost_per_year,
      target_stage = target_stage,
      mult = multiplier
    )
  }
  
  if (startsWith(design_row$param_name, "invasive_rate_")) {
    target_cancer <- sub("invasive_rate_", "", design_row$param_name)
    
    # Only modify if this cancer is in the data
    dl$screening_fp_diag_costs <- dl$screening_fp_diag_costs %>%
      mutate(
        Invasive_procedure = if_else(
          Cancer == target_cancer & Invasive_procedure > 0,
          Invasive_procedure * get_scalar(design_row$new_value),
          Invasive_procedure
        )
      )
  }
  
  # 5F. Modify scalar params directly
  if (design_row$param_name %in%
      c("mced_compliance_rate", "overdiagnosis_factor", "mced_test_cost",
        "fp_track_num", "mced_fp_compliance", "fp_disutility_val",
        "d_c", "d_e")) {
    ip[[design_row$param_name]] <- get_scalar(design_row$new_value)
  }
  
  # 5G. Compliance frequency multiplier (for screening)
  if (design_row$param_name == "Compliance_frequency") {
    dl$screening_fp_diag_costs <- compliance_freq_mult(
      dl$screening_fp_diag_costs,
      get_scalar(design_row$new_value),
      screen_cancers
    )
  }
  
  # 5H. Extreme or by-stage cost per year
  if (design_row$param_name == "cpy_extreme") {
    type <- if (design_row$new_value == 1) "plus" else "minus"
    dl$cost_per_year <- cpy_extreme_by_cancer(
      df   = dl$cost_per_year,
      type = type
    )
  }
  
  # 5I. Invasive multiplier
  if (design_row$param_name == "invasive_multi_mult") {
    ip$invasive_multi <- get_scalar(design_row$new_value)
  }
  
  # 5J. Dwell scenario
  if (design_row$param_name == "dwell_scenario") {
    if (design_row$new_value == 1) {
      ip$dwell_scenario <- "Scenario_1"
      ip$ss_scenario    <- 1
    } else if (design_row$new_value == 2) {
      ip$dwell_scenario <- "Scenario_3"
      ip$ss_scenario    <- 5
    } else {
      ip$dwell_scenario <- "Scenario_2"
      ip$ss_scenario    <- 3
    }
  }
  
  # 5K. Adjust screening-cost table
  if (design_row$param_name == "screen_cost_pct") {
    dl$screening_fp_diag_costs <- screen_cost_pct(dl$screening_fp_diag_costs,
                                                  get_scalar(design_row$new_value))
  }
  
  if (design_row$param_name == "fp_incidental_cost_pct") {
    dl$screening_fp_diag_costs <- dl$screening_fp_diag_costs |>
      cost_component_pct(get_scalar(design_row$new_value), "FP_cost") |>
      cost_component_pct(get_scalar(design_row$new_value), "incidental_cost")
  }
  
  if (design_row$param_name == "invasive_cost_pct") {
    dl$screening_fp_diag_costs <-
      cost_component_pct(dl$screening_fp_diag_costs,
                         get_scalar(design_row$new_value),
                         "invasive_cost")
  }
  
  # 5L. Adjust utilities/survival/cost-per-year
  if (design_row$param_name == "util_mult") {
    dl$utility_long <- util_mult(dl$utility_long, get_scalar(design_row$new_value))
  }
  
  if (design_row$param_name == "survival_mult") {
    dl$transposed_survival <- surv_mult(dl$transposed_survival, get_scalar(design_row$new_value))
  }
  
  if (design_row$param_name == "cost_per_year_mult") {
    dl$cost_per_year <- cpy_mult(dl$cost_per_year, get_scalar(design_row$new_value))
  }
  
  # 5M. If d_e changed, recalc expanded utility
  if (design_row$param_name == "d_e") {
    dl$expanded_utility <- update_utility(
      d_e            = get_scalar(design_row$new_value),
      over_all_data_folder = "Data/overall",
      female_prop    = def_param_list$female_prop
    )
  }
  
  # 5N. Adjust mortality
  if (design_row$param_name == "all_cause_mortality_mult") {
    dl$all_cancer_mort <- adjust_all_cause_mort(
      all_cause_raw = read_csv("Data/overall/all_cause_mortality_40.csv"),
      cancer_mort   = read_csv("Data/overall/cancer_mort.csv"),
      cancer_list   = cancer_types,
      mult_all_cause = get_scalar(design_row$new_value),
      mult_total_cancer = 1  # leave cancer as is
    )
  }
  
  if (design_row$param_name == "total_cancer_mortality_mult") {
    dl$all_cancer_mort <- adjust_all_cause_mort(
      all_cause_raw    = read_csv("Data/overall/all_cause_mortality_40.csv"),
      cancer_mort      = read_csv("Data/overall/cancer_mort.csv"),
      cancer_list      = cancer_types,
      mult_all_cause   = 1,
      mult_total_cancer= get_scalar(design_row$new_value)
    )
  }
  
  # 5O. RUN THE MODEL
  res <- run_usual_model(
    cancer_list          = cancer_types_overall,
    data_list            = dl,
    def_param_list       = def_param_list,
    input_params         = ip,
    original_sensitivity = local_sens,
    specificity_data     = local_spec,
    Values               = sensitivity_matrix,
    cancer_types_overall = cancer_types_overall
  )
  
  # 5P. EXTRACT & RETURN RESULTS
  icer_df <- res$final_result_list$Overall$final_icer_result
  
  out_tibble <- tibble(
    run_id              = design_row$run_id,
    param_name          = design_row$param_name,
    change_type         = design_row$change_type,
    new_value           = design_row$new_value,
    Incremental_Cost    = icer_df$Value[icer_df$Variable=="Incremental_Cost"],
    Incremental_Utility = icer_df$Value[icer_df$Variable=="Incremental_Utility"],
    ICER                = icer_df$Value[icer_df$Variable=="ICER"],
    Mced_cost = icer_df$Value[icer_df$Variable == "mced_cost"],
    Mced_utility = icer_df$Value[icer_df$Variable == "mced_utility"],
    Usual_cost = icer_df$Value[icer_df$Variable == "usual_cost"],
    Usual_utility = icer_df$Value[icer_df$Variable == "usual_utility"]
  )
  
  message(
    "\n---> Results for run ",
    design_row$run_id,
    " (", design_row$param_name, " – ", design_row$change_type, "):\n"
  )
  print(out_tibble)
  
  # 5Q. SAVE RESULTS
  out_rds_file <- file.path(
    result_dir,
    paste0("final_results_", design_row$run_id, ".rds")
  )
  saveRDS(res$final_result_list, out_rds_file)
  
  return(out_tibble)
}

run_sensitivity_analysis <- function(dsa_design, 
                                     input_params, 
                                     data_loaded,
                                     df_sensitivity,
                                     original_specificity,
                                     sensitivity_matrix,
                                     def_param_list,
                                     cancer_types_overall,
                                     folder_suffix = "_1") {
  
  # 1. Create top-level folder if it doesn't exist
  dir.create("Sensitivity_analysis", showWarnings = FALSE)
  
  # 2. Create subfolder named with today's date (plus optional suffix)
  #    e.g. "2023-05-12_1"
  date_str   <- as.character(Sys.Date())  # e.g. "2023-05-12"
  result_dir <- file.path("Sensitivity_analysis", paste0(date_str, folder_suffix))
  dir.create(result_dir, showWarnings = FALSE)
  
  # 3. Write the design CSV to that subfolder
  readr::write_csv(dsa_design, file.path(result_dir, "dsa_design.csv"))
  
  # 4. Run each row of the design, returning a combined data frame
  dsa_results <- purrr::map_dfr(
    split(dsa_design, dsa_design$run_id),
    run_one,
    base_params         = input_params,
    base_data           = data_loaded,
    df_sensitivity      = df_sensitivity,
    original_specificity = original_specificity,
    sensitivity_matrix  = sensitivity_matrix,
    def_param_list      = def_param_list,
    cancer_types_overall = cancer_types_overall,
    result_dir          = result_dir  # pass folder path
  )
  
  # 5. Optionally, also save the final aggregated results
  readr::write_csv(dsa_results, file.path(result_dir, "dsa_results.csv"))
  
  return(invisible(dsa_results))
}

